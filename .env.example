# ==========================================
# Zaao Food - Customer Website Environment Configuration
# ==========================================
# NOTE: Never put secret service role keys or OTP provider secrets here.
# Only safe, public-facing configuration placeholders are included.

# Supabase (Future Phase Integration)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-public-anon-key

# RTCOM SMS / OTP Gateway (Public-facing endpoint identifier or client flag)
NEXT_PUBLIC_RTCOM_OTP_ENABLED=false

# Delivery Center (Default: Mathbaria Bazar, Pirojpur, Bangladesh)
NEXT_PUBLIC_MATHBARIA_CENTER_LAT=22.2858
NEXT_PUBLIC_MATHBARIA_CENTER_LNG=89.9614

# App Environment
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000
