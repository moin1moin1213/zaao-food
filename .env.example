# ====================================================================
# PenguFood — Environment Configuration Template
# ====================================================================
# Copy this file to .env.local (for local development) or configure in your hosting provider.

# 1. Supabase Backend Configuration
# --------------------------------------------------------------------
# Project URL from Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Public Publishable Key (Anon Key) — Safe for browsers & mobile apps
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-public-anon-key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-public-anon-key

# Secret Service Role Key — SERVER-SIDE ONLY (API routes, migrations)
# WARNING: NEVER expose this key to browser code or the Rider App!
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-never-expose

# For Rider App (Expo)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-public-anon-key

# 2. Central Admin Portal Security
# --------------------------------------------------------------------
ADMIN_PASSWORD=your-secure-admin-passphrase-here

# 3. SMS Gateway & OTP Verification (Mathbaria Local Phone Delivery)
# --------------------------------------------------------------------
SMS_GATEWAY_PROVIDER=https://api.rtcom.xyz/onetomany
SMS_GATEWAY_API_KEY=your-sms-api-key
SMS_GATEWAY_ACODE=your-sms-account-code
SMS_SENDER_ID=PenguFood
NEXT_PUBLIC_SMS_OTP_ENABLED=true

# 4. Mathbaria Bazar Delivery Center Geolocation
# --------------------------------------------------------------------
NEXT_PUBLIC_MATHBARIA_CENTER_LAT=22.2858
NEXT_PUBLIC_MATHBARIA_CENTER_LNG=89.9614

# 5. Application URLs & Environment
# --------------------------------------------------------------------
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000
