# ==========================================
# PenguFood — Production Environment Configuration
# ==========================================
# Copy this file to .env.local (for local development)
# or configure these in your Vercel / Cloud hosting environment settings.

# 1. Supabase Backend (Database & Realtime)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-public-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-never-expose-to-browser

# 2. SMS / OTP Provider (RTCOM / Greenweb / BulkSMS BD)
SMS_GATEWAY_PROVIDER=rtcom
SMS_GATEWAY_API_KEY=your-sms-api-key
SMS_SENDER_ID=PenguFood
NEXT_PUBLIC_SMS_OTP_ENABLED=true

# 3. Mathbaria Delivery Center Coordinates
NEXT_PUBLIC_MATHBARIA_CENTER_LAT=22.2858
NEXT_PUBLIC_MATHBARIA_CENTER_LNG=89.9614

# 4. App & Deployment URL
NEXT_PUBLIC_APP_ENV=production
NEXT_PUBLIC_SITE_URL=https://pengufood.com

# 5. Online Payment Gateway (Optional - Keep COD as default)
# BKASH_APP_KEY=your-bkash-app-key
# BKASH_APP_SECRET=your-bkash-secret
# NAGAD_MERCHANT_ID=your-nagad-merchant-id
# SSLCOMMERZ_STORE_ID=your-sslcommerz-store-id
