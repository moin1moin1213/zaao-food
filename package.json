{
  "name": "pengufood",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "clean": "node -e \"const fs = require('fs'); try { fs.rmSync('.next', { recursive: true, force: true }); fs.rmSync('tsconfig.tsbuildinfo', { force: true }); console.log('Cache cleaned successfully'); } catch(e){}\"",
    "dev": "npm run dev --prefix customer-web",
    "dev:customer": "npm run dev --prefix customer-web",
    "dev:admin": "npm run dev --prefix admin-portal",
    "dev:restaurant": "npm run dev --prefix restaurant-portal",
    "dev:rider": "npm run web --prefix rider-app",
    "build": "next build",
    "build:all": "npm run build --prefix customer-web && npm run build --prefix admin-portal && npm run build --prefix restaurant-portal",
    "start": "npm run start --prefix customer-web",
    "lint": "next lint",
    "test": "node src/lib/__tests__/verifyAll.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "@types/leaflet": "^1.9.22",
    "clsx": "^2.1.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.475.0",
    "next": "^15.1.7",
    "next-themes": "^0.4.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.2",
    "tailwind-merge": "^3.0.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3"
  }
}
