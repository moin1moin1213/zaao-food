# ====================================================================
# PenguFood Android Rider App (Expo React Native) Environment Configuration
# ====================================================================
# In Expo, any variable accessible in the app MUST start with EXPO_PUBLIC_
# WARNING: NEVER put secret service_role keys here!

# 1. Supabase Backend Project URL
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# 2. Supabase Public Publishable Key (Anon Key)
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-public-anon-key
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-public-anon-key

# 3. Mathbaria Operational Center Coordinates
EXPO_PUBLIC_MATHBARIA_CENTER_LAT=22.2858
EXPO_PUBLIC_MATHBARIA_CENTER_LNG=89.9614
